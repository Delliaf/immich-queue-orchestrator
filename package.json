{
  "name": "immich-queue-orchestrator",
  "version": "0.1.5",
  "description": "A safe, resource-aware queue orchestrator for Immich",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/main.ts",
    "docs:check": "node scripts/check-doc-translations.mjs",
    "docs:sync": "node scripts/check-doc-translations.mjs --write",
    "lint": "eslint .",
    "mock:immich": "node scripts/mock-immich.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.11.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
