# Copy this file to .env and fill both values. Never commit the real .env file.
IMMICH_QUEUE_ORCHESTRATOR_API_KEY=
# Optional. Leave empty for a trusted home network; set any non-empty value to enable panel login.
IMMICH_QUEUE_ORCHESTRATOR_ADMIN_PASSWORD=
# Panel bind address. Set this to the server's ZeroTier IP for ZeroTier-only access.
IMMICH_QUEUE_ORCHESTRATOR_BIND_IP=127.0.0.1
